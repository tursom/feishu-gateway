# Production: all admin requests must arrive through a Pangolin-protected resource.
AUTH_MODE=pangolin
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://feishu-api.example.com
# Generate: openssl rand -hex 32. Configure the trusted upstream to OVERWRITE
# X-Gateway-Secret with the same value. Do not send it to API clients.
PANGOLIN_PROXY_SECRET=
# Actual direct peer IP(s), not X-Forwarded-For. Exact addresses only.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional only if your trusted proxy overwrites this identity header:
# PANGOLIN_IDENTITY_HEADER=x-pangolin-user-email
DATABASE_PATH=./data/gateway.sqlite
# Default reuses the existing local Feishu configuration.
FEISHU_CREDENTIALS_FILE=/root/.config/feishu/credentials.json
# FEISHU_APP_ID and FEISHU_APP_SECRET can alternatively be provided by a secret manager.
FEISHU_LOCK_DIR=/root/.cache/pi-feishu-locks
