# Optional Compose settings. No .env file is required to start.
FEISHU_IMAGE=ghcr.io/tursom/feishu-gateway:latest
PORT=8787
FEISHU_DATA_DIR=./data

# Native binary only (Compose uses its image defaults):
# LISTEN_ADDR=:8787
# DATABASE_PATH=./data/gateway.sqlite

# Configure Feishu App ID / App Secret in the admin Settings page.
# Pangolin protects the admin routes; only /api/v1/* bypasses Pangolin login.
